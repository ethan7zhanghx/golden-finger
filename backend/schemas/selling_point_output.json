{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SellingPointOutput",
  "description": "核心卖点提炼步骤的输出 schema",
  "type": "object",
  "required": ["logline", "selling_points", "positioning", "differentiation"],
  "properties": {
    "logline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "一句话 logline"
    },
    "selling_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["point", "description", "audience_appeal", "priority"],
        "properties": {
          "point": { "type": "string" },
          "description": { "type": "string" },
          "audience_appeal": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "additionalProperties": false
      },
      "description": "核心卖点列表"
    },
    "positioning": {
      "type": "string",
      "minLength": 1,
      "description": "作品定位"
    },
    "differentiation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "与同类作品的差异化要素"
    }
  },
  "additionalProperties": false
}
